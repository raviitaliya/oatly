PORT=8000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/plant_milk_store
DB_NAME=plant_milk_store
JWT_SECRET=replace_with_a_long_random_secret
CLIENT_URL=http://localhost:5173
CLIENT_URLS=http://localhost:5173,http://localhost:5174
RATE_LIMIT_MAX=500

# Email / existing email verification + password reset system
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay
RAZORPAY_API_KEY=
RAZORPAY_API_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_WEBHOOK_SECRET=

# Firebase Admin (choose one)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
